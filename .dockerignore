# Do not ship credentials, local DBs, caches, or host-specific dependencies
.git
.env
.env.*
!.env.example
**/__pycache__
**/*.py[cod]
**/.pytest_cache
**/venv
**/.venv
**/node_modules
frontend/dist
backend/data
data/*.db
data/*.sqlite
data/*.sqlite3

# Raw transcript sources and the derived full-text chunk index are fetched at runtime.
data/transcripts/*
data/index/*
