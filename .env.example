# ==============================================================================
# The Lenny Growth Assistant - Environment Configuration
# ==============================================================================

# Application Environment (development | production | test)
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# The frontend uses same-origin /api paths; no separate API URL is required.

# Database Configuration
# Default to SQLite for zero-setup local Windows development.
# For PostgreSQL with Docker Compose, use:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lenny_growth
# SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lenny_growth
DATABASE_URL=sqlite+aiosqlite:///./data/lenny_growth.db
SYNC_DATABASE_URL=sqlite:///./data/lenny_growth.db

# LLM Provider Configuration
# Active default provider: "ollama" | "openai" | "anthropic"
DEFAULT_LLM_PROVIDER=ollama

# Local Ollama Settings (No API key needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Cloud LLM Providers (Optional for cloud switching)
OPENAI_API_KEY = 
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# RAG & Knowledge Base Configuration
TRANSCRIPTS_DATA_DIR=./data/transcripts
VECTOR_INDEX_DIR=./data/index
TOP_K_RETRIEVAL=4
SIMILARITY_THRESHOLD=0.35
